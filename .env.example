# PostgreSQL Database URL (Local or Cloud Serverless like Neon / Supabase)
# For Neon / Vercel Postgres, make sure to append '?sslmode=require'
DATABASE_URL="postgresql://user:password@ep-cool-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Security
JWT_SECRET="your-super-secure-jwt-secret-key-here"

# Resend API Key for Email Delivery (Get yours from https://resend.com/api-keys)
RESEND_API_KEY="re_your_resend_api_key_here"

# Public App URL (Your Vercel Domain in production, or http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# Resend Verified Sender or Default Sandbox
EMAIL_FROM="Sinoma Warehouse ERP <onboarding@resend.dev>"
